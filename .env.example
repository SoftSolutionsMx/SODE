# ==============================================================================
# SODE Email Service Configuration (Google SMTP)
# ==============================================================================

# Backend for email sending (use smtp.EmailBackend for production/Google SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Google SMTP Server Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Google Account Credentials
# Requires 2-Step Verification enabled on your Google account.
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
EMAIL_TIMEOUT=10

# Email verification on signup (True: mandatory verification, False: auto-verify)
SODE_EMAIL_VERIFICATION=False

# ==============================================================================
# Live Integration Tests
# ==============================================================================
# Set to True only when you explicitly want to test sending real emails via Google SMTP.
# Kept False by default to avoid email spamming when running `py manage.py test`.
RUN_LIVE_EMAIL_TESTS=False
LIVE_TEST_RECIPIENT_EMAIL=your-test-recipient@gmail.com
LIVE_TEST_SECONDARY_RECIPIENT_EMAIL=your-second-recipient@gmail.com

